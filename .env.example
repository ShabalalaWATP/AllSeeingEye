# The All Seeing Eye: environment variables.
# Copy to .env and fill in real values. Never commit .env.

# Environment: dev | test | prod. Prod requires ASE_JWT_SECRET and enables secure cookies.
ASE_ENV=dev

# Database URL. SQLite for local development; PostgreSQL when running under Docker Compose
# (the compose file builds the PostgreSQL URL from the POSTGRES_* values below).
ASE_DATABASE_URL=sqlite+aiosqlite:///./data/ase.db

# JWT signing secret: at least 32 random characters, for example `openssl rand -base64 48`.
# Required in prod. In dev and test a random one is generated at every start.
ASE_JWT_SECRET=

# Access token lifetime in minutes (1 to 120) and refresh token lifetime in days (1 to 90).
ASE_ACCESS_TOKEN_MINUTES=15
ASE_REFRESH_TOKEN_DAYS=14

# Send cookies only over HTTPS. Defaults to true in prod and false otherwise.
# ASE_COOKIE_SECURE=true

# Public URL of the web app, used to build activation and password reset links.
ASE_PUBLIC_BASE_URL=http://localhost:5173

# Optional account email and MFA codes. Configure host and sender together.
# TLS certificate verification is mandatory. STARTTLS defaults to port 587;
# set security=tls and port=465 for implicit TLS. Unset keeps email MFA unavailable.
# ASE_SMTP_HOST=
# ASE_SMTP_FROM_EMAIL=
# ASE_SMTP_PORT=587
# ASE_SMTP_SECURITY=starttls
# Optional relay credentials, both required when authentication is used.
# ASE_SMTP_USERNAME=
# ASE_SMTP_PASSWORD=
# Socket timeout, 1 to 30 seconds.
# ASE_SMTP_TIMEOUT_SECONDS=10

# Log level: DEBUG | INFO | WARNING | ERROR
ASE_LOG_LEVEL=INFO

# Password for `ase create-admin` when you do not want an interactive prompt. Remove afterwards.
# ASE_ADMIN_PASSWORD=

# Rate limits (requests per window; login windows are one minute, the others one hour).
# ASE_RATE_LIMIT_LOGIN_PER_IP=10
# ASE_RATE_LIMIT_LOGIN_PER_EMAIL=5
# ASE_RATE_LIMIT_REQUEST_ACCOUNT_PER_IP=3
# ASE_RATE_LIMIT_FORGOT_PER_IP=3
# ASE_RATE_LIMIT_SET_PASSWORD_PER_IP=10
# Report generations per user per hour (each one calls the configured model).
# ASE_RATE_LIMIT_REPORTS_PER_USER=10

# Ordinary JSON request limit (1 KB to 10 MB). Caddy normally enforces 64 KB.
# The authenticated research upload path has a separate fixed 8 MiB cap.
# ASE_MAX_REQUEST_BYTES=65536

# Live feeds. Contact address sent in the User-Agent (upstreams ask for one), and a
# comma-separated list of source ids to leave out (see /api/admin/sources for ids).
# ASE_FEEDS_CONTACT=you@example.com
# ASE_FEEDS_DISABLED=
# Shared conflict relevance screening uses only the global assessment model and public feed text.
# At most 10 reports/call, 4,000 output tokens/call and 6 calls/hour per API process.
# No model or matching source text leaves machine-coded reports unreviewed and default-hidden.
# ASE_CONFLICT_SCREENING_ENABLED=true
# ASE_CONFLICT_SCREENING_CALLS_PER_HOUR=6
# Restart-safe CelesTrak orbital inputs and request cooldowns, one feed worker per directory.
# Defaults relative to the API working directory; keep on a writable persistent volume.
# ASE_SATELLITE_CACHE_DIR=data/celestrak
# UCDP monthly historical baseline, public CSV by default, CC BY 4.0 with citation.
# Explicit release version, not a live conflict feed. Disable via ASE_FEEDS_DISABLED=ucdp_candidate.
# ASE_UCDP_CANDIDATE_VERSION=26.0.7
# Optional UCDP API token selects authenticated paged JSON instead of the public CSV.
# Request a free token via the maintainer listed at https://ucdp.uu.se/apidocs/.
# ASE_UCDP_ACCESS_TOKEN=
# Optional ACLED OAuth bearer token, valid for 24 hours, account entitlement applies.
# Obtain/renew externally through https://acleddata.com/oauth/token. No password is stored here.
# ASE_ACLED_ACCESS_TOKEN=
# Optional ReliefWeb pre-approved appname (https://apidoc.reliefweb.int/parameters#appname).
# Configuring this replaces the general ReliefWeb RSS feed with the latest 100 API reports.
# ASE_RELIEFWEB_APPNAME=
# NASA FIRMS free MAP_KEY, server-side only. Unset means no FIRMS collection.
# ASE_FIRMS_MAP_KEY=
# Latest UTC day, NOAA-20 VIIRS; world or west,south,east,north (no dateline wrapping).
# ASE_FIRMS_AREA=world
# Ask the Wayback Machine to preserve the URLs each report cites (runs after generation;
# sends those URLs to archive.org). Set to false to keep cited URLs on this host only.
# ASE_ARCHIVE_ENABLED=true

# Alert routing: every fired indicator is POSTed as JSON to this public https address
# (private and loopback hosts are refused). Unset keeps alerts in the app and on the stream.
# ASE_ALERT_WEBHOOK_URL=
# Memory budget for the live event store in MB (16 to 8192).
# ASE_LIVE_STORE_MEMORY_MB=512

# Encrypts API keys entered in the admin UI (LLM profiles). Any string of at least 32
# random characters, for example `openssl rand -base64 48`. Changing it makes stored keys
# unreadable, so they would need re-entering. Required before LLM profiles can be saved.
# ASE_ENCRYPTION_KEY=

# Ordnance Survey Data Hub API key (free OpenData plan) for the OS Maps base layers.
# The key stays on the server: tiles are proxied through /api/tiles/os. Unset hides OS Maps.
# ASE_OS_MAPS_KEY=

# Optional free Companies House public API key for UK company research. Kept server-side.
# Use GB:01234567 or companies-house:01234567 to distinguish UK numbers from SEC CIKs.
# ASE_COMPANIES_HOUSE_KEY=

# Optional SSLMate CT Search API key. The free Small account supports exact-hostname queries.
# Returns a bounded first page of unexpired certificates, not complete certificate history.
# ASE_CERTIFICATE_TRANSPARENCY_KEY=

# Optional free OpenAlex key for scholarly metadata research. Sent server-side as a Bearer
# header. Unset keeps anonymous access; collection remains opt-in and capped at 20 results.
# ASE_OPENALEX_API_KEY=

# Optional OpenAQ v3 key for on-demand area air-quality research. Server-side only,
# sent to api.openaq.org in X-API-Key. Restart the API after setting.
# ASE_OPENAQ_API_KEY=

# Optional free WSDOT highway camera access code, issued at https://www.wsdot.wa.gov/traffic/api/.
# Server-side only. Enables Washington camera snapshots; restart the API after setting.
# ASE_WSDOT_ACCESS_CODE=

# Trusted local media executables; otherwise discovered on PATH. Never user upload paths.
# Images use Tesseract for English OCR; video needs both FFmpeg and FFprobe.
# ASE_RESEARCH_TESSERACT_PATH=
# ASE_RESEARCH_FFMPEG_PATH=
# ASE_RESEARCH_FFPROBE_PATH=

# Docker Compose only: PostgreSQL credentials for the db service and the Caddy site address
# (use your Tailscale hostname or LAN address to reach the app from other devices).
POSTGRES_USER=ase
# Set a unique, randomly generated password before starting Docker Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=ase
ASE_SITE_ADDRESS=localhost
# Proxies whose X-Forwarded-For the API trusts. "*" is safe while the API port stays
# unpublished (only Caddy can reach it); set Caddy's address if you ever publish port 8000.
# ASE_FORWARDED_ALLOW_IPS=*
## OONI aggregate data is CC BY-NC-SA 4.0. Enable only after confirming suitable use.
ASE_OONI_NONCOMMERCIAL_USE_ACKNOWLEDGED=false
# Optional paths to validated immutable snapshots created with ase import-designations.
ASE_UKSL_SNAPSHOT_PATH=
ASE_OFAC_SDN_SNAPSHOT_PATH=

# Optional immutable local GeoGCDF catalogue created by ase import-aiddata.
ASE_AIDDATA_CATALOGUE_PATH=

# Optional absolute path to operator-owned isolated Linux PDF runtime JSON.
# Omit to retain existing PDF/DOCX rendering. No browser is installed automatically.
# ASE_REPORT_PDF_RUNTIME=

# Optional global ship positions, server-side only. Create a free key at https://aisstream.io/
# Restart the API after setting. Regional Fintraffic AIS works without this.
ASE_AISSTREAM_API_KEY=
ASE_CLOUDFLARE_RADAR_TOKEN=

# Ukraine war tracker frontline providers, all off by default (docs/UKRAINE_WAR_TRACKER.md).
# Set granted only after DeepStateMap has approved API use for this deployment.
# ASE_UKRAINE_DEEPSTATE_ACCESS=granted
# Set true only for a humanitarian deployment; the OCHA layer is intended for that use.
# ASE_UKRAINE_OCHA_HUMANITARIAN=false
# Set true after reading WarSpotting's terms; draws geolocated Russian losses.
# ASE_UKRAINE_WARSPOTTING=false

# Optional Norwegian/Arctic AIS snapshots. Create a separate AIS API client with scope ais,
# not the general BarentsWatch api client. Keep both values server-side and restart the API.
# https://developer.barentswatch.no/docs/tutorial/
# ASE_BARENTSWATCH_CLIENT_ID=
# ASE_BARENTSWATCH_CLIENT_SECRET=

# Reserved local credentials for future general BarentsWatch API adapters (scope api).
# The current ship connector does not consume these; it uses the separate AIS client above.
# ASE_BARENTSWATCH_API_CLIENT_ID=
# ASE_BARENTSWATCH_API_CLIENT_SECRET=
