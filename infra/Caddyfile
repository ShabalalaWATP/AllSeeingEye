# Serves the built SPA and proxies the API. HTTPS uses Caddy's internal CA for the site
# address below; when the app is exposed with a real domain, replace `tls internal` with
# automatic ACME certificates and enable the HSTS header.

{$ASE_SITE_ADDRESS:localhost} {
	encode gzip
	header -Server
	@ordinary not path /api/research/inputs /api/map/views /api/map/views/* /api/reports/*/original-assets/*/content
	request_body @ordinary {
		max_size 64KB
	}
	@research_upload path /api/research/inputs /api/reports/*/original-assets/*/content
	request_body @research_upload {
		# The API admits only exact UUID PUT routes before reading original bytes.
		max_size 8MiB
	}
	@map_image_export path /api/map/views/*/revisions/*/image-package
	request_body @map_image_export {
		# Exact POST routes authorise before the bounded PNG JSON envelope is read.
		max_size 12MiB
	}
	@map_views {
		path /api/map/views /api/map/views/*
		not path /api/map/views/*/revisions/*/image-package
	}
	request_body @map_views {
		# API enforces the tighter state/envelope cap on save routes only.
		max_size 7MiB
	}

	handle /api/* {
		# The API sets its own strict headers (CSP default-src 'none', no-store); Caddy
		# only proxies them through.
		reverse_proxy api:8000
	}

	handle {
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			# MapLibre sets inline styles on its controls, hence style-src 'unsafe-inline'.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://tiles.maps.eox.at; connect-src 'self' https://tiles.openfreemap.org https://tiles.maps.eox.at; worker-src 'self' blob:; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
			# Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}

	tls internal
}
