# Serves the built SPA and proxies the API. Two deployment settings decide how HTTPS is
# issued and whether HSTS is asserted, so the same image serves a LAN address and a public
# domain without an edit here:
#
#   ASE_TLS            `internal` (default) uses Caddy's own CA, for localhost and LAN
#                      addresses. An email address switches on automatic ACME certificates
#                      for a real domain, and receives the issuer's expiry notices.
#   ASE_HSTS_MAX_AGE   0 (default) asserts no policy, which is correct behind the internal
#                      CA. 31536000 (a year) is the public setting; browsers then refuse
#                      plain HTTP for this host, so only set it once HTTPS works.

{$ASE_SITE_ADDRESS:localhost} {
	encode gzip
	header -Server
	@ordinary not path /api/research/inputs /api/map/views /api/map/views/* /api/reports/*/original-assets/*/content
	request_body @ordinary {
		max_size 64KB
	}
	@research_upload path /api/research/inputs /api/reports/*/original-assets/*/content
	request_body @research_upload {
		# The API admits only exact UUID PUT routes before reading original bytes.
		max_size 8MiB
	}
	@map_image_export path /api/map/views/*/revisions/*/image-package
	request_body @map_image_export {
		# Exact POST routes authorise before the bounded PNG JSON envelope is read.
		max_size 12MiB
	}
	@map_views {
		path /api/map/views /api/map/views/*
		not path /api/map/views/*/revisions/*/image-package
	}
	request_body @map_views {
		# API enforces the tighter state/envelope cap on save routes only.
		max_size 7MiB
	}

	handle /api/* {
		# The API sets its own strict headers (CSP default-src 'none', no-store); Caddy
		# only proxies them through.
		reverse_proxy api:8000
	}

